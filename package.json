{
  "name": "aidlc_mikelopster_workshop",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "overview:shots": "node scripts/capture-overview.mjs",
    "smoke": "node scripts/smoke.mjs",
    "test:unit": "vitest --run --project=unit",
    "test:integration": "vitest --run --project=integration",
    "test:backend": "vitest --run --project=unit --project=integration --coverage",
    "test:report": "vitest --run --reporter=default --reporter=json --outputFile.json=reports/test-results.json --coverage",
    "db:seed": "tsx scripts/seed/cli.ts",
    "db:reset": "tsx scripts/seed/cli.ts --reset",
    "db:check": "tsx scripts/seed/cli.ts --check"
  },
  "dependencies": {
    "@xyflow/react": "^12.12.0",
    "mermaid": "^11.17.2",
    "next": "16.3.8",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "swagger-ui-dist": "^5.33.1",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "latest",
    "@storybook/addon-a11y": "^10.6.1",
    "@storybook/addon-docs": "^10.6.1",
    "@storybook/addon-mcp": "^10.6.1",
    "@storybook/addon-vitest": "^10.6.1",
    "@storybook/nextjs-vite": "^10.6.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24.19.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/browser-playwright": "^4",
    "@vitest/coverage-v8": "^4",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "eslint-plugin-storybook": "^10.6.1",
    "playwright": "latest",
    "storybook": "^10.6.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vite": "latest",
    "vitest": "^4"
  },
  "scarfSettings": {
    "enabled": false
  },
  "engines": {
    "node": ">=22.13"
  },
  "overrides": {
    "katex": "^0.19.0"
  }
}
